import vapoursynth as vs
core = vs.core
import havsfunc as haf

try:
    src = vs.get_output(index=1)
except KeyError:
    src = core.lsmas.LWLibavSource(r'C:/Users/WIP/AppData/Local/Programs/MPEG Video/01 - 06 (1960s) It Was a Short Summer, Charlie Brown (1969).mkv')
    src.set_output(index=1)

src = core.std.Splice(clips=[src[0:45470],])

src = core.fh.FieldHint(clip=src, tff=1, matches='')

section0 = src[0:]
src = core.std.Splice(mismatch=True, clips=[section0,])

dec0 = core.std.SelectEvery(clip=src[0:40], cycle=5, offsets=[1,2,3,4,])
dec40 = core.std.SelectEvery(clip=src[40:45], cycle=5, offsets=[1,2,3,])
dec45 = core.std.SelectEvery(clip=src[45:8660], cycle=5, offsets=[0,1,2,3,])
dec8665 = core.std.SelectEvery(clip=src[8665:8730], cycle=5, offsets=[1,2,3,4,])
dec8730 = core.std.SelectEvery(clip=src[8730:8735], cycle=5, offsets=[1,2,3,])
dec8735 = core.std.SelectEvery(clip=src[8735:9215], cycle=5, offsets=[0,1,2,3,])
dec9220 = core.std.SelectEvery(clip=src[9220:9305], cycle=5, offsets=[1,2,3,4,])
dec9305 = core.std.SelectEvery(clip=src[9305:9310], cycle=5, offsets=[1,2,3,])
dec9310 = core.std.SelectEvery(clip=src[9310:10680], cycle=5, offsets=[0,1,2,3,])
dec10680 = core.std.SelectEvery(clip=src[10680:10710], cycle=5, offsets=[0,2,3,4,])
dec10710 = core.std.SelectEvery(clip=src[10710:16185], cycle=5, offsets=[0,1,2,3,])
dec16185 = core.std.SelectEvery(clip=src[16185:16290], cycle=5, offsets=[0,1,2,4,])
dec16290 = core.std.SelectEvery(clip=src[16290:16640], cycle=5, offsets=[0,1,2,3,])
dec16640 = core.std.SelectEvery(clip=src[16640:16740], cycle=5, offsets=[0,1,2,4,])
dec16740 = core.std.SelectEvery(clip=src[16740:21060], cycle=5, offsets=[0,1,2,3,])
dec21060 = core.std.SelectEvery(clip=src[21060:21140], cycle=5, offsets=[0,1,2,4,])
dec21140 = core.std.SelectEvery(clip=src[21140:27970], cycle=5, offsets=[0,1,2,3,])
dec27970 = core.std.SelectEvery(clip=src[27970:28090], cycle=5, offsets=[0,1,2,4,])
dec28090 = core.std.SelectEvery(clip=src[28090:31595], cycle=5, offsets=[0,1,2,3,])
dec31595 = core.std.SelectEvery(clip=src[31595:31605], cycle=5, offsets=[0,1,3,4,])
dec31605 = core.std.SelectEvery(clip=src[31605:36400], cycle=5, offsets=[0,1,2,3,])
dec36400 = core.std.SelectEvery(clip=src[36400:36450], cycle=5, offsets=[0,1,2,4,])
dec36450 = core.std.SelectEvery(clip=src[36450:40430], cycle=5, offsets=[0,1,2,3,])
dec40430 = core.std.SelectEvery(clip=src[40430:40475], cycle=5, offsets=[0,1,2,4,])
dec40475 = core.std.SelectEvery(clip=src[40475:41750], cycle=5, offsets=[0,1,2,3,])
dec41750 = core.std.SelectEvery(clip=src[41750:41810], cycle=5, offsets=[0,1,2,4,])
dec41810 = core.std.SelectEvery(clip=src[41810:45470], cycle=5, offsets=[0,1,2,3,])

src = core.std.Splice(mismatch=True, clips=[dec0,dec40,dec45,src[8660:8665],dec8665,dec8730,dec8735,src[9215:9220],dec9220,dec9305,dec9310,dec10680,dec10710,dec16185,dec16290,dec16640,dec16740,dec21060,dec21140,dec27970,dec28090,dec31595,dec31605,dec36400,dec36450,dec40430,dec40475,dec41750,dec41810,])
src = core.std.Crop(src, left=4, right=4, top=2, bottom=2)
src = core.resize.Spline36(src, width=640, height=480)
src = haf.daa(src)##AA+contra-sharpening
src = core.deblock.Deblock(src, quant=30) 
src = core.fft3dfilter.FFT3DFilter(src)
src = core.grain.Add(src, var=0.7, seed=-1)
src = core.resize.Spline36(src, format=vs.YUV420P10, range_s="limited")
src.set_output(index=0)
